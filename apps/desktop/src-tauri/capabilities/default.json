{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Cursorbuddy desktop windows",
  "windows": ["settings", "mascot", "overlay"],
  "permissions": [
    "core:default",
    "global-shortcut:default",
    "notification:default",
    "opener:default",
    "os:default",
    "process:default",
    "store:default",
    "dialog:default"
  ]
}
