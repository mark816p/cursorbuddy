{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Cursorbuddy",
  "version": "0.1.0",
  "identifier": "com.cursorbuddy.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Cursorbuddy Settings",
        "label": "settings",
        "width": 850,
        "height": 620,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      },
      {
        "title": "Cursorbuddy Setup",
        "label": "onboarding",
        "width": 640,
        "height": 520,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "url": "index.html?window=onboarding"
      },
      {
        "title": "Cursorbuddy Mascot",
        "label": "mascot",
        "width": 160,
        "height": 160,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "url": "index.html?window=mascot"
      },
      {
        "title": "Cursorbuddy Overlay",
        "label": "overlay",
        "fullscreen": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "url": "index.html?window=overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://localhost:* https://api.cursorbuddy.ai wss://api.cursorbuddy.ai"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "oneClick": true,
        "perMachine": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mark816p/cursorbuddy/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxRTI5QTZBQTI1RUQ3ODUKUldTYkRvd3ZtTk4ycGpmVnJ2dWl0OHhrcDlsbkpnRGVvT01wUG51L2l1Z3h1UG5wTk5yQW4reU8K"
    }
  }
}
