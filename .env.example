# Cursorbuddy Environment Configuration Template
# Duplicate this file to .env for local server development.
# NEVER commit .env files to source control.

# ==============================================================================
# LLM Configuration (Anthropic)
# ==============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-sonnet-5-5
LLM_FAST_MODEL=claude-haiku-5-5

# ==============================================================================
# Speech-To-Text (STT) Provider
# Options: "openai" | "deepgram"
# ==============================================================================
STT_PROVIDER=openai
STT_API_KEY=your_stt_provider_api_key_here

# ==============================================================================
# Text-To-Speech (TTS) Provider
# Options: "elevenlabs" | "openai"
# ==============================================================================
TTS_PROVIDER=elevenlabs
TTS_API_KEY=your_tts_provider_api_key_here
TTS_VOICE=21m00Tcm4TlvDq8ikWAM

# ==============================================================================
# Supabase Authentication & Database
# ==============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# ==============================================================================
# Stripe Billing & Subscriptions
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly_id

# ==============================================================================
# Desktop Client & Networking
# ==============================================================================
APP_DEEP_LINK_SCHEME=cursorbuddy
UPDATER_PUBKEY=your_tauri_updater_public_key_here
SERVER_URL=http://localhost:3001
PORT=3001
NODE_ENV=development
